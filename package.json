{
  "name": "pi-claude-code",
  "version": "0.1.0",
  "description": "pi extensions: Claude Code and Antigravity CLIs as model providers (several accounts), plus a status line, usage charts, task list, subagents, pi's own MCP server for the agents (permissions, questions, wishes, watches, steps), chat view improvements, work status, image paste and an IDE connection. One line per extension in README.md.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "claude",
    "claude-code",
    "antigravity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gozrid/pi-claude-code.git"
  },
  "pi": {
    "extensions": [
      "./extensions/claude-code/index.ts",
      "./extensions/antigravity/index.ts",
      "./extensions/agent-status-line/index.ts",
      "./extensions/usage-graph/index.ts",
      "./extensions/provider-logo/index.ts",
      "./extensions/chat-crab/index.ts",
      "./extensions/work-status/index.ts",
      "./extensions/task-list/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/pi-bridge/index.ts",
      "./extensions/permission-retry/index.ts",
      "./extensions/chat-view/index.ts",
      "./extensions/image-paste/index.ts",
      "./extensions/commands/index.ts",
      "./extensions/ide/index.ts"
    ]
  },
  "scripts": {
    "check": "node scripts/typecheck.mjs",
    "test": "node --import ./scripts/register-pi.mjs --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
